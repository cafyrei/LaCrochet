# La Crochet backend settings.
# 1. Copy this file and name the copy  .env  (in this same backend folder).
# 2. Fill in the values. Ask the team lead for the team's TEST keys in a private message.
# 3. Never upload .env to GitHub (it's already in .gitignore). This example file has no secrets, so it's safe.
# Restart the backend after changing .env.

# ---- Required ----
# Supabase > Connect > Session pooler. Add "+psycopg" after "postgresql".
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Any long random sentence. Changing it logs everyone out.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# ---- Shop details (Contact page, and the rider's pickup info) ----
SHOP_NAME=La Crochet
SHOP_PHONE=
SHOP_ADDRESS=
SHOP_EMAIL=
SHOP_HOURS=
SHOP_FACEBOOK=
SHOP_INSTAGRAM=

# ---- PayRex online payments (optional; use sk_test_ keys only while testing) ----
PAYREX_API_SECRET=
PAYREX_WEBHOOK_SECRET=
# Your ngrok address, only when testing online payments (PayRex refuses localhost).
PUBLIC_API_URL=

# ---- Lalamove delivery (optional; pk_test_/sk_test_ = sandbox, no real riders) ----
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# The shop's map pin, where riders pick up.
SHOP_LAT=
SHOP_LNG=

# ---- Gemini for Yarnie the chat helper (optional) ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BACKUP_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# GEMINI_THINKING=minimal

# ---- Tests only: a SEPARATE, EMPTY database the tests are allowed to wipe ----
TEST_DATABASE_URL=
